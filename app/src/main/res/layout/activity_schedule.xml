<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📅 جدولي الجامعي"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#0D47A1"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <!-- شريط أيام الأسبوع أفقياً -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSat"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="السبت"
                android:layout_marginEnd="6dp"
                android:textSize="13sp"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/btnSun"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="الأحد"
                android:layout_marginEnd="6dp"
                android:textSize="13sp"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/btnMon"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="الإثنين"
                android:layout_marginEnd="6dp"
                android:textSize="13sp"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/btnTue"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="الثلاثاء"
                android:layout_marginEnd="6dp"
                android:textSize="13sp"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/btnWed"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="الأربعاء"
                android:layout_marginEnd="6dp"
                android:textSize="13sp"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/btnThu"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="الخميس"
                android:layout_marginEnd="6dp"
                android:textSize="13sp"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/btnFri"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="الجمعة"
                android:textSize="13sp"
                android:textColor="#FFFFFF"/>

        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvCurrentDayTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="مواعيد اليوم"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:layout_marginBottom="8dp"/>

    <ListView
        android:id="@+id/listViewSchedule"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnOpenAddSchedule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="إضافة محاضرة أو سكشن جديد +"
        android:backgroundTint="#0D47A1"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:padding="12dp"/>

</LinearLayout>